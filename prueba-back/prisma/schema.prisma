generator client {
  provider = "prisma-client-js" 
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String  
  name      String?
  role      Role     @default(USER) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  @@map("users")
}

model Item {
  id          String   @id @default(uuid())
  name        String   
  description String  
  price       Float    
  category    String  
  imageUrl    String   
  createdAt   DateTime @default(now()) 
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("items")
}
